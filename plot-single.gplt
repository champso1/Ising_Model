# plots the output of single simulation, giving magnetization and energy per iteration

set terminal pdfcairo enhanced notransparent
set border lw 1.5

set output "energy.pdf"
set xlabel "N [iterations per lattice site]"
set ylabel "Energy [J/k_b]"
set title "Energy vs. Iterations"
plot "single.dat" using 1:2 with points notitle

set output "magnetization.pdf"
set xlabel "N [iterations per lattice site]"
set ylabel "Magnetization"
set title "Magnetization vs. Iterations"
plot "single.dat" using 1:3 with points notitle
